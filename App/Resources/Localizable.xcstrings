    "fp.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fingerprint is pinned on first trust (TOFU) and any later change will be blocked with an alert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹在首次信任时固定（TOFU）；此后任何变更都会被阻断并告警。"
          }
        }
      }
    },
