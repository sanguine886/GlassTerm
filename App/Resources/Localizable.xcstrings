    "fp.changed.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's host key does not match the pinned one. This can mean a server reinstall — or an interception attempt. Do not proceed unless you can verify the new fingerprint out of band."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器主机密钥与已固定的不一致。这可能是服务器重装系统，也可能是中间人攻击。除非你能通过其他渠道核实新指纹，否则不要继续。"
          }
        }
      }
    },
    "fp.changed.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I verified — update key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核实——更新指纹"
          }
        }
      }
    },
    "fp.changed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host key changed!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机密钥已变更！"
          }
        }
      }
    },
    "fp.new.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the first connection to this server. Verify the host key fingerprint before trusting it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是与该服务器的首次连接。请先核对主机密钥指纹再信任。"
          }
        }
      }
    },
    "fp.new.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust & connect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任并连接"
          }
        }
      }
    },
    "fp.new.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify host key"
